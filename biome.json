{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": ["**", "!public", "!.next"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "attributePosition": "auto",
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": { "noUnknownAtRules": "off" },
          "complexity": { "noImportantStyles": "off" }
        }
      }
    },
    {
      "includes": ["**/__tests__/**", "**/*.test.tsx", "**/*.test.ts", "vitest.setup.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "performance": { "noImgElement": "off" },
          "style": { "noNonNullAssertion": "off" },
          "correctness": { "noUnusedFunctionParameters": "off" },
          "a11y": { "useButtonType": "off" }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
